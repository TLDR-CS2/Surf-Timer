<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SurfTimer</RootNamespace>
    <AssemblyName>SurfTimer</AssemblyName>
    <Version>0.1.0</Version>
    <PackageVersion>0.1.0</PackageVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TieredCompilation>true</TieredCompilation>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/$(AssemblyName)</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="1.4.5" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BotControllerApi">
      <HintPath>lib\BotControllerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tools\lifecycle-tests\**\*.cs" />
    <Compile Remove="tools\sharptimer-import\**\*.cs" />
    <Compile Remove="tools\replay-tests\**\*.cs" />
    <Compile Remove="tools\database-load-tests\**\*.cs" />
    <Compile Remove="tools\soak-tests\**\*.cs" />
    <Compile Remove="tools\catalog-tests\**\*.cs" />
    <Compile Remove="web\**\*.cs" />
  </ItemGroup>
</Project>
